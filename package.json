{
  "name": "clipboard-net",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-platform clipboard synchronization desktop app (Windows, Ubuntu/Debian & macOS) with E2EE and multi-transport support",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
